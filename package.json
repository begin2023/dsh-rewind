{
  "name": "@begin2023/dsh-rewind",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "begin2023"
  },
  "homepage": "https://github.com/begin2023/dsh-rewind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/begin2023/dsh-rewind.git"
  },
  "bugs": {
    "url": "https://github.com/begin2023/dsh-rewind/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek", "deepseek-harness", "conversation", "message-editing", "regenerate", "attachments"],
  "description": "DSH 插件：编辑用户消息、重新生成助手回复，保留图片与文件。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "icon.svg",
    "locale",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs && node test/host.mjs && node test/render.mjs && node test/interact.mjs",
    "test:consumer": "node test/pack-consumer.mjs",
    "prepack": "npm run check && npm test"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
